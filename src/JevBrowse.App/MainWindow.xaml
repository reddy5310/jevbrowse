<Window x:Class="JevBrowse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:JevBrowse.App"
        Title="JevBrowse">
    <Grid x:Name="Root" Background="{ThemeResource JevSurface0Brush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnPaletteAccelerator"/>
            <KeyboardAccelerator Key="F1" Invoked="OnHelpAccelerator"/>
            <!-- conventional browser shortcuts -->
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnFocusAddress"/>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewTabAccelerator"/>
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseTabAccelerator"/>
            <KeyboardAccelerator Key="T" Modifiers="Control,Shift" Invoked="OnReopenClosedAccelerator"/>
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnReloadAccelerator"/>
            <KeyboardAccelerator Key="F5" Invoked="OnReloadAccelerator"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnNextTabAccelerator"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="OnPrevTabAccelerator"/>
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="OnZoomInAccelerator"/>
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="OnZoomOutAccelerator"/>
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="OnZoomResetAccelerator"/>
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnToggleSidebarAccelerator"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="276"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Custom title bar with the accent line: the window itself reads as one layered surface. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource JevSpace10}" VerticalAlignment="Center" Margin="{StaticResource JevInsetTitle}">
                <Border Width="10" Height="10" CornerRadius="{StaticResource JevRadiusDot}" Background="{ThemeResource JevAccentBrush}"/>
                <TextBlock Text="JevBrowse" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="TitleHint" Text="Ctrl+K for commands · F1 for help" FontSize="12" Foreground="{ThemeResource JevTextSecondaryBrush}"/>
            </StackPanel>
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource JevAccentBrush}" Opacity="0.35"/>
        </Grid>

        <!-- Sidebar: a floating panel with depth. Every logical resource is visible; the dot says whether it is live. -->
        <Border local:Elevation.Level="Panel" x:Name="Sidebar" Grid.Row="1" Grid.Column="0" Margin="{StaticResource JevInsetSidebar}" CornerRadius="{StaticResource JevRadiusPanel}" Background="{ThemeResource JevSurface1Brush}" BorderBrush="{ThemeResource JevBorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Padding="{StaticResource JevInsetSidebarHead}" Spacing="{StaticResource JevSpace8}">
                    <local:WrapPanel Spacing="{StaticResource JevSpace6}" LineSpacing="{StaticResource JevSpace6}">
                        <Button Content="+ New" Click="OnNewTab" Style="{StaticResource JevToolButton}"/>
                        <Button Content="Sleep others" Click="OnHibernateAll" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Put every tab except this one to sleep to free memory. They wake when you open them."/>
                        <Button Content="&#xE71C;" FontFamily="Segoe MDL2 Assets" Click="OnPalette" AutomationProperties.Name="Command palette" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Command palette (Ctrl+K)"/>
                        <Button Content="&#xE897;" FontFamily="Segoe MDL2 Assets" Click="OnHelp" AutomationProperties.Name="Help and welcome" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Welcome / help (F1)"/>
                    </local:WrapPanel>
                    <ComboBox x:Name="ProductModeBox" AutomationProperties.Name="Product mode" HorizontalAlignment="Stretch" Style="{StaticResource JevCombo}" SelectionChanged="OnProductModeChanged" ToolTipService.ToolTip="Product mode: which features are shown"/>
                    <TextBlock x:Name="PrivateSessionText" TextWrapping="Wrap" Visibility="Collapsed" FontSize="12"/>
                    <Button x:Name="ReturnPrivateButton" Content="Return" Click="OnReturnFromPrivate" Visibility="Collapsed" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Leave the private session but keep it open"/>
                    <Button x:Name="EndPrivateButton" Content="End private session" Click="OnEndPrivateSession" Visibility="Collapsed" Style="{StaticResource JevToolButton}"/>
                    <ComboBox x:Name="ModeBox" AutomationProperties.Name="Memory budget" HorizontalAlignment="Stretch" Style="{StaticResource JevCombo}" SelectionChanged="OnModeChanged" ToolTipService.ToolTip="Memory budget mode (Resource OS)"/>
                    <Grid ColumnSpacing="{StaticResource JevSpace6}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="WorkspaceBox" AutomationProperties.Name="Workspace" HorizontalAlignment="Stretch" Style="{StaticResource JevCombo}" SelectionChanged="OnWorkspaceChanged" ToolTipService.ToolTip="Workspace (Context OS)"/>
                        <Button Grid.Column="1" Content="+" Click="OnNewWorkspace" AutomationProperties.Name="New workspace" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="New workspace"/>
                        <Button x:Name="TimelineButton" AutomationProperties.Name="Time Travel: restore an earlier context" Grid.Column="2" Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" Click="OnTimeline" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Time Travel: restore an earlier context"/>
                    </Grid>
                    <Button x:Name="LabButton" Content="Lab" Click="OnMemoryLab" Style="{StaticResource JevToolButton}" Visibility="Collapsed"/>
                </StackPanel>
                <ListView x:Name="TabList" AutomationProperties.Name="Open tabs" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnTabSelected" ItemsSource="{x:Bind Items}" Padding="{StaticResource JevInsetSlim}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="Padding" Value="10,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TabItem">
                            <!-- The row announces title AND state: the coloured dot is the only visual carrier of
                                 "sleeping" / "playing sound", and a dot announces nothing. IsAccessibilityView=Raw on
                                 the inner text stops Narrator reading the same words again after the row name. -->
                            <Grid ColumnSpacing="{StaticResource JevSpace10}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border local:Elevation.Level="Glow" Width="10" Height="10" CornerRadius="{StaticResource JevRadiusDot}" VerticalAlignment="Center" Background="{x:Bind StateBrush, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="13" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource JevTextSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="{StaticResource JevInsetTight}" Background="Transparent" BorderThickness="0" Click="OnCloseTab" Tag="{x:Bind Id}"
                                        AutomationProperties.Name="{x:Bind CloseName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind CloseName, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Margin="{StaticResource JevInsetSidebarFoot}" Padding="{StaticResource JevInsetBox}" CornerRadius="{StaticResource JevRadiusCard}" Background="{ThemeResource JevSurface0Brush}" BorderBrush="{ThemeResource JevBorderSubtleBrush}" BorderThickness="1">
                    <TextBlock x:Name="PoolText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource JevTextSecondaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="MainArea" Grid.Row="1" Grid.Column="1" SizeChanged="OnMainAreaSizeChanged" Margin="{StaticResource JevInsetMain}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- One toolbar. Everyday navigation leads and gets the width; the trust and diagnostics controls sit to its
                 right; everything about the current tab is under "This tab", and mode-gated extras under "Tools". -->
            <Grid x:Name="Toolbar" Grid.Row="0" Padding="{StaticResource JevInsetToolbar}" ColumnSpacing="{StaticResource JevSpace6}" RowSpacing="{StaticResource JevSpace6}" SizeChanged="OnToolbarSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="AddressColumn" Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SidebarToggle" Grid.Column="0" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Click="OnToggleSidebar" Style="{StaticResource JevToolButton}"
                        ToolTipService.ToolTip="Hide sidebar (Ctrl+B)" AutomationProperties.Name="Hide sidebar"/>
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Grid.Column="1" Click="OnBack" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back"/>
                <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Grid.Column="2" Click="OnForward" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward"/>
                <Button x:Name="ReloadButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Grid.Column="3" Click="OnReloadClick" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Reload this page (Ctrl+R)" AutomationProperties.Name="Reload"/>
                <Border local:Elevation.Level="Raised" x:Name="AddressPill" Grid.Column="4" CornerRadius="{StaticResource JevRadiusPill}" Background="{ThemeResource JevSurface1Brush}" BorderBrush="{ThemeResource JevBorderSubtleBrush}" BorderThickness="1" Padding="{StaticResource JevInsetSlim}">
                    <Grid ColumnSpacing="{StaticResource JevSpace8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- A Button, not a tappable TextBlock: this is where a person changes how a site is treated, and a TextBlock with a
                             Tapped handler cannot be reached by keyboard or screen reader at all. -->
                        <Button x:Name="ClassBadge" Padding="{StaticResource JevInsetBadge}" MinHeight="0" MinWidth="0" CornerRadius="{StaticResource JevRadiusSm}" VerticalAlignment="Center" BorderThickness="0"
                                Background="{ThemeResource JevBadgeUnknownBrush}" Click="OnClassBadgeTapped"
                                ToolTipService.ToolTip="How JevBrowse treats this page. Click to change it for this site."
                                AutomationProperties.Name="How this page is treated">
                            <TextBlock x:Name="ClassBadgeText" FontSize="10.5" FontWeight="SemiBold" Text="PERSONAL" Foreground="{ThemeResource JevBadgeTextBrush}"/>
                        </Button>
                        <TextBox x:Name="AddressBox" Grid.Column="1" PlaceholderText="Search or enter address" KeyDown="OnAddressKeyDown" BorderThickness="0" Background="Transparent" FontSize="13.5"/>
                    </Grid>
                </Border>
                <!-- The trust and tab controls travel as ONE group. Wide: right of the address bar. Narrow: a second row, so
                     Explain and Receipt stay directly reachable instead of disappearing into an overflow menu. -->
                <local:WrapPanel x:Name="TrustBar" Grid.Column="5" Spacing="{StaticResource JevSpace6}" LineSpacing="{StaticResource JevSpace6}">
                    <!-- Shown only while an agent session is running: what is happening, and a Stop that needs no dialog (stopping is the safe direction). -->
                    <StackPanel x:Name="AgentGroup" Orientation="Horizontal" Spacing="{StaticResource JevSpace4}" Visibility="Collapsed">
                        <Button x:Name="AgentBadge" Click="OnAgentActivity" Style="{StaticResource JevToolButton}" BorderBrush="{ThemeResource JevAccentSolidBrush}" BorderThickness="1"/>
                        <Button x:Name="AgentStopButton" Content="Stop" Click="OnStopAgents" Style="{StaticResource JevToolButton}"/>
                    </StackPanel>
                    <Button x:Name="ShieldButton" Content="Shield" Click="OnShield" Style="{StaticResource JevToolButton}"
                            ToolTipService.ToolTip="What was blocked on this page, and a fix if the site is not working" AutomationProperties.Name="Shield: blocked requests and site repair"/>
                    <Button x:Name="ExplainButton" Content="Explain" Click="OnExplain" Style="{StaticResource JevToolButton}"
                            ToolTipService.ToolTip="Why this tab is awake or asleep" AutomationProperties.Name="Explain why this tab is awake or asleep"/>
                    <Button x:Name="ReceiptButton" Content="Receipt" Click="OnReceipt" Style="{StaticResource JevToolButton}"
                            ToolTipService.ToolTip="What this site did during your visit: requests, blocked items, memory used" AutomationProperties.Name="Receipt: what this site did"/>
                    <Button x:Name="TabMenuButton" Content="This tab &#x25BE;" Style="{StaticResource JevToolButton}"
                            ToolTipService.ToolTip="Sleep, pin, keep active, or move this tab" AutomationProperties.Name="This tab menu">
                        <Button.Flyout>
                            <MenuFlyout x:Name="TabMenu" Placement="BottomEdgeAlignedRight" Opening="OnMoveMenuOpening">
                                <MenuFlyoutItem x:Name="SleepItem" Text="Put to sleep" Click="OnHibernateCurrent"/>
                                <MenuFlyoutItem x:Name="PinButton" Text="Pin to top" Click="OnPinCurrent"/>
                                <MenuFlyoutItem x:Name="KeepActiveButton" Text="Keep active" Click="OnKeepActiveCurrent"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutSubItem x:Name="MoveMenu" Text="Move to workspace"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="ToolsButton" Content="Tools &#x25BE;" Style="{StaticResource JevToolButton}"
                            ToolTipService.ToolTip="Ask AI about this page, search what you have read, and more" AutomationProperties.Name="Tools menu">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="AskButton" Text="Summarize this page" Click="OnAsk"/>
                                <MenuFlyoutItem x:Name="MemoryButton" Text="Search pages you have read" Click="OnMemory"/>
                                <MenuFlyoutItem x:Name="BrainButton" Text="AI settings and log" Click="OnBrain"/>
                                <MenuFlyoutItem x:Name="DevButton" Text="Developer tools" Click="OnDev"/>
                                <MenuFlyoutItem x:Name="AgentsButton" Text="Agents" Click="OnAgents"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="MoreButton" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource JevToolButton}"
                            ToolTipService.ToolTip="Command palette (Ctrl+K) and help (F1)" AutomationProperties.Name="More: command palette and help">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Command palette" Click="OnPalette"/>
                                <MenuFlyoutItem Text="Workspaces overview" Click="OnWorkspaceOverview"/>
                                <MenuFlyoutItem Text="Agent activity" Click="OnAgentActivity"/>
                                <MenuFlyoutItem Text="Help and welcome" Click="OnHelp"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </local:WrapPanel>
            </Grid>
            <!-- One side panel for information that used to interrupt in a dialog. It is not modal: the page stays alive beside it,
                 Tab moves through it like anything else, Esc or the close button dismisses it, and focus goes back to where it
                 came from. Declared before the page so it follows the toolbar in Tab order. Where the window is too narrow to
                 hold both, it takes the page's place instead of covering it (a web view cannot be drawn under other controls). -->
            <Border x:Name="SidePanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Right" Width="360" local:Elevation.Level="Surface"
                    CornerRadius="{StaticResource JevRadiusPanel}" Background="{ThemeResource JevSurface1Brush}" BorderBrush="{ThemeResource JevBorderSubtleBrush}"
                    BorderThickness="1" KeyDown="OnSidePanelKeyDown">
                <Grid RowSpacing="{StaticResource JevSpace4}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="{StaticResource JevInsetSidebarHead}" ColumnSpacing="{StaticResource JevSpace8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SidePanelTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <Button x:Name="SidePanelClose" Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Click="OnSidePanelClose"
                                Style="{StaticResource JevToolButton}" AutomationProperties.Name="Close panel" ToolTipService.ToolTip="Close (Esc)"/>
                    </Grid>
                    <ScrollViewer x:Name="SidePanelBody" AutomationProperties.AutomationId="SidePanelBody" Grid.Row="1" Padding="{StaticResource JevInsetSidebarFoot}" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"/>
                </Grid>
            </Border>
            <Border local:Elevation.Level="Surface" x:Name="PageSurface" Grid.Row="1" CornerRadius="{StaticResource JevRadiusPanel}" BorderBrush="{ThemeResource JevBorderSubtleBrush}" BorderThickness="1" Background="{ThemeResource JevBackdropBrush}">
                <Grid>
                    <Grid x:Name="WebHost" CornerRadius="{StaticResource JevRadiusPanel}">
                        <!-- Shown while a sleeping tab comes back, and when nothing is selected. Never implies the
                             live page is present: the preview is labelled as a saved image. -->
                        <StackPanel x:Name="RestorePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource JevSpace12}" MaxWidth="460" Padding="{StaticResource JevInsetPanelPad}">
                            <Border x:Name="PreviewFrame" Visibility="Collapsed" CornerRadius="{StaticResource JevRadiusControl}" BorderThickness="1" BorderBrush="{ThemeResource JevBorderSubtleBrush}" HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="PreviewImage" MaxHeight="240" Stretch="Uniform"/>
                                    <Border Background="{ThemeResource JevScrimBrush}" VerticalAlignment="Bottom" Padding="{StaticResource JevInsetScrim}">
                                        <TextBlock Text="Previous view — a saved image, not the live page" FontSize="11" Foreground="{ThemeResource JevBadgeTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="RestoreTitle" HorizontalAlignment="Center" TextAlignment="Center" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RestoreStatus" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12.5" Foreground="{ThemeResource JevTextSecondaryBrush}" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="RestoreProgress" IsIndeterminate="True" Width="200" Visibility="Collapsed"/>
                            <StackPanel x:Name="RestoreActions" Orientation="Horizontal" Spacing="{StaticResource JevSpace8}" HorizontalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Try again" Click="OnRestoreRetry" Style="{StaticResource JevToolButton}"/>
                                <Button Content="Open the address" Click="OnRestoreOpenAddress" Style="{StaticResource JevToolButton}"/>
                                <Button Content="Keep this tab active" Click="OnRestoreKeepActive" Style="{StaticResource JevToolButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ProdBorder" CornerRadius="{StaticResource JevRadiusPanel}" BorderBrush="{ThemeResource JevDangerBrush}" BorderThickness="4" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Border x:Name="EnvBadge" Background="{ThemeResource JevDangerBrush}" CornerRadius="{StaticResource JevRadiusTag}" Padding="{StaticResource JevInsetTag}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="EnvBadgeText" Foreground="{ThemeResource JevBadgeTextBrush}" FontWeight="Bold" FontSize="12" Text="PROD"/>
                    </Border>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusText" Grid.Row="2" Padding="{StaticResource JevInsetStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource JevTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</Window>

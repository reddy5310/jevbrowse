<Window x:Class="JevBrowse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:JevBrowse.App"
        Title="JevBrowse">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: every logical resource is visible; the badge says whether it owns a renderer. -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Padding="8" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="+ New" Click="OnNewTab"/>
                    <Button Content="Hibernate all" Click="OnHibernateAll" ToolTipService.ToolTip="Virtualize everything except current"/>
                    <Button Content="Lab" Click="OnMemoryLab"/>
                </StackPanel>
                <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged" ToolTipService.ToolTip="Memory budget mode (Resource OS)"/>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="WorkspaceBox" HorizontalAlignment="Stretch" SelectionChanged="OnWorkspaceChanged" ToolTipService.ToolTip="Workspace (Context OS)"/>
                    <Button Grid.Column="1" Content="+" Click="OnNewWorkspace" ToolTipService.ToolTip="New workspace"/>
                    <Button Grid.Column="2" Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" Click="OnTimeline" ToolTipService.ToolTip="Time Travel: restore an earlier context"/>
                </Grid>
            </StackPanel>
            <ListView x:Name="TabList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnTabSelected" ItemsSource="{x:Bind Items}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TabItem">
                        <Grid ColumnSpacing="6" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{x:Bind StateBrush, Mode=OneWay}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="4" Background="Transparent" BorderThickness="0" Click="OnCloseTab" Tag="{x:Bind Id}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="PoolText" Grid.Row="2" Padding="8" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Click="OnBack"/>
                <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Grid.Column="1" Click="OnForward"/>
                <Grid Grid.Column="2" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ClassBadge" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" ToolTipService.ToolTip="Identity container • data class (Trust OS). Click to override.">
                        <TextBlock x:Name="ClassBadgeText" FontSize="11" Text="PERSONAL" Tapped="OnClassBadgeTapped"/>
                    </Border>
                    <TextBox x:Name="AddressBox" Grid.Column="1" PlaceholderText="Search or enter address" KeyDown="OnAddressKeyDown"/>
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <Button Content="Hibernate" Click="OnHibernateCurrent" ToolTipService.ToolTip="Dispose this renderer; keep the tab"/>
                    <Button Content="Pin" Click="OnPinCurrent" ToolTipService.ToolTip="Never auto-hibernate this tab"/>
                    <Button x:Name="MoveButton" Content="Move to…" ToolTipService.ToolTip="Move this tab to another workspace">
                        <Button.Flyout>
                            <MenuFlyout x:Name="MoveMenu" Opening="OnMoveMenuOpening"/>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Explain" Click="OnExplain" ToolTipService.ToolTip="Why did the scheduler last touch this tab?"/>
                    <Button x:Name="ShieldButton" Content="Shield" Click="OnShield" ToolTipService.ToolTip="Blocked requests on this page; disable per site"/>
                    <Button Content="Ask" Click="OnAsk" ToolTipService.ToolTip="Summarize this page (explicit; you confirm before anything is sent)"/>
                    <Button Content="Brain" Click="OnBrain" ToolTipService.ToolTip="AI switches and the decision log"/>
                    <Button Content="Memory" Click="OnMemory" ToolTipService.ToolTip="Search everything you've read (local index of public pages)"/>
                    <Button Content="Dev" Click="OnDev" ToolTipService.ToolTip="DevSpace: environment, localhost, errors, network (optional module)"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid x:Name="WebHost">
                    <TextBlock x:Name="VirtualPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" Text="No live renderer. Select a tab."/>
                </Grid>
                <!-- DevSpace PROD chrome: unmissable, drawn over the page edges, hit-test transparent. -->
                <Border x:Name="ProdBorder" BorderBrush="#E0FF3B30" BorderThickness="4" IsHitTestVisible="False" Visibility="Collapsed"/>
                <Border x:Name="EnvBadge" Background="#E0FF3B30" CornerRadius="0,0,6,0" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="EnvBadgeText" Foreground="White" FontWeight="Bold" FontSize="12" Text="PROD"/>
                </Border>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="2" Padding="8,4" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>

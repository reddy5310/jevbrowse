<Window x:Class="JevBrowse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:JevBrowse.App"
        Title="JevBrowse">
    <Grid x:Name="Root" Background="{StaticResource JevBgBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnPaletteAccelerator"/>
            <KeyboardAccelerator Key="F1" Invoked="OnHelpAccelerator"/>
            <!-- conventional browser shortcuts -->
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnFocusAddress"/>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewTabAccelerator"/>
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseTabAccelerator"/>
            <KeyboardAccelerator Key="T" Modifiers="Control,Shift" Invoked="OnReopenClosedAccelerator"/>
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnReloadAccelerator"/>
            <KeyboardAccelerator Key="F5" Invoked="OnReloadAccelerator"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnNextTabAccelerator"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="OnPrevTabAccelerator"/>
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="OnZoomInAccelerator"/>
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="OnZoomOutAccelerator"/>
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="OnZoomResetAccelerator"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Custom title bar with the accent line: the window itself reads as one layered surface. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="14,0">
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource JevAccentBrush}"/>
                <TextBlock Text="JevBrowse" FontWeight="SemiBold" FontSize="13" Opacity="0.9"/>
                <TextBlock x:Name="TitleHint" Text="Ctrl+K for commands · F1 for help" FontSize="12" Opacity="0.45"/>
            </StackPanel>
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource JevAccentBrush}" Opacity="0.35"/>
        </Grid>

        <!-- Sidebar: a floating panel with depth. Every logical resource is visible; the dot says whether it is live. -->
        <Border Grid.Row="1" Grid.Column="0" Margin="10,8,4,10" CornerRadius="16" Background="{StaticResource JevPanelBrush}" BorderBrush="{StaticResource JevLineBrush}" BorderThickness="1" Shadow="{StaticResource JevShadow}" Translation="0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Padding="12,12,12,6" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="+ New" Click="OnNewTab" Style="{StaticResource JevToolButton}"/>
                        <Button Content="Sleep others" Click="OnHibernateAll" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Put every tab except this one to sleep to free memory. They wake when you open them."/>
                        <Button Content="&#xE71C;" FontFamily="Segoe MDL2 Assets" Click="OnPalette" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Command palette (Ctrl+K)"/>
                        <Button Content="&#xE897;" FontFamily="Segoe MDL2 Assets" Click="OnHelp" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Welcome / help (F1)"/>
                    </StackPanel>
                    <ComboBox x:Name="ProductModeBox" HorizontalAlignment="Stretch" Style="{StaticResource JevCombo}" SelectionChanged="OnProductModeChanged" ToolTipService.ToolTip="Product mode: which features are shown"/>
                    <TextBlock x:Name="PrivateSessionText" TextWrapping="Wrap" Visibility="Collapsed" FontSize="12"/>
                    <Button x:Name="ReturnPrivateButton" Content="Return" Click="OnReturnFromPrivate" Visibility="Collapsed" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Leave the private session but keep it open"/>
                    <Button x:Name="EndPrivateButton" Content="End private session" Click="OnEndPrivateSession" Visibility="Collapsed" Style="{StaticResource JevToolButton}"/>
                    <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" Style="{StaticResource JevCombo}" SelectionChanged="OnModeChanged" ToolTipService.ToolTip="Memory budget mode (Resource OS)"/>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="WorkspaceBox" HorizontalAlignment="Stretch" Style="{StaticResource JevCombo}" SelectionChanged="OnWorkspaceChanged" ToolTipService.ToolTip="Workspace (Context OS)"/>
                        <Button Grid.Column="1" Content="+" Click="OnNewWorkspace" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="New workspace"/>
                        <Button x:Name="TimelineButton" Grid.Column="2" Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" Click="OnTimeline" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Time Travel: restore an earlier context"/>
                    </Grid>
                    <Button x:Name="LabButton" Content="Lab" Click="OnMemoryLab" Style="{StaticResource JevToolButton}" Visibility="Collapsed"/>
                </StackPanel>
                <ListView x:Name="TabList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnTabSelected" ItemsSource="{x:Bind Items}" Padding="6,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="Padding" Value="10,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TabItem">
                            <!-- The row announces title AND state: the coloured dot is the only visual carrier of
                                 "sleeping" / "playing sound", and a dot announces nothing. IsAccessibilityView=Raw on
                                 the inner text stops Narrator reading the same words again after the row name. -->
                            <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Background="{x:Bind StateBrush, Mode=OneWay}" Shadow="{StaticResource JevShadow}" Translation="0,0,8" AutomationProperties.AccessibilityView="Raw"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="13" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.55" AutomationProperties.AccessibilityView="Raw"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="4" Background="Transparent" BorderThickness="0" Click="OnCloseTab" Tag="{x:Bind Id}"
                                        AutomationProperties.Name="{x:Bind CloseName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind CloseName, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Margin="10,6,10,10" Padding="10,8" CornerRadius="12" Background="#0E1119" BorderBrush="{StaticResource JevLineBrush}" BorderThickness="1">
                    <TextBlock x:Name="PoolText" FontSize="12" TextWrapping="Wrap" Opacity="0.85"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="4,8,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- One toolbar. Everyday navigation leads and gets the width; the trust and diagnostics controls sit to its
                 right; everything about the current tab is under "This tab", and mode-gated extras under "Tools". -->
            <Grid Grid.Row="0" Padding="0,0,0,8" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Click="OnBack" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back"/>
                <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Grid.Column="1" Click="OnForward" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward"/>
                <Button x:Name="ReloadButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Grid.Column="2" Click="OnReloadClick" Style="{StaticResource JevToolButton}" ToolTipService.ToolTip="Reload this page (Ctrl+R)" AutomationProperties.Name="Reload"/>
                <Border Grid.Column="3" CornerRadius="14" Background="{StaticResource JevPanelBrush}" BorderBrush="{StaticResource JevLineBrush}" BorderThickness="1" Padding="6,0" Shadow="{StaticResource JevShadow}" Translation="0,0,12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ClassBadge" CornerRadius="8" Padding="8,2" VerticalAlignment="Center" Background="#1F5F5A" ToolTipService.ToolTip="Identity container • data class (Trust OS). Click to override.">
                            <TextBlock x:Name="ClassBadgeText" FontSize="10.5" FontWeight="SemiBold" Text="PERSONAL" Tapped="OnClassBadgeTapped"/>
                        </Border>
                        <TextBox x:Name="AddressBox" Grid.Column="1" PlaceholderText="Search or enter address" KeyDown="OnAddressKeyDown" BorderThickness="0" Background="Transparent" FontSize="13.5"/>
                    </Grid>
                </Border>
                <Button x:Name="ShieldButton" Grid.Column="4" Content="Shield" Click="OnShield" Style="{StaticResource JevToolButton}"
                        ToolTipService.ToolTip="What was blocked on this page, and a fix if the site is not working" AutomationProperties.Name="Shield: blocked requests and site repair"/>
                <Button x:Name="ExplainButton" Grid.Column="5" Content="Explain" Click="OnExplain" Style="{StaticResource JevToolButton}"
                        ToolTipService.ToolTip="Why this tab is awake or asleep" AutomationProperties.Name="Explain why this tab is awake or asleep"/>
                <Button x:Name="ReceiptButton" Grid.Column="6" Content="Receipt" Click="OnReceipt" Style="{StaticResource JevToolButton}"
                        ToolTipService.ToolTip="What this site did during your visit: requests, blocked items, memory used" AutomationProperties.Name="Receipt: what this site did"/>
                <Button x:Name="TabMenuButton" Grid.Column="7" Content="This tab &#x25BE;" Style="{StaticResource JevToolButton}"
                        ToolTipService.ToolTip="Sleep, pin, keep active, or move this tab" AutomationProperties.Name="This tab menu">
                    <Button.Flyout>
                        <MenuFlyout x:Name="TabMenu" Opening="OnMoveMenuOpening">
                            <MenuFlyoutItem x:Name="SleepItem" Text="Put to sleep" Click="OnHibernateCurrent"/>
                            <MenuFlyoutItem x:Name="PinButton" Text="Pin to top" Click="OnPinCurrent"/>
                            <MenuFlyoutItem x:Name="KeepActiveButton" Text="Keep active" Click="OnKeepActiveCurrent"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutSubItem x:Name="MoveMenu" Text="Move to workspace"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ToolsButton" Grid.Column="8" Content="Tools &#x25BE;" Style="{StaticResource JevToolButton}"
                        ToolTipService.ToolTip="Ask AI about this page, search what you have read, and more" AutomationProperties.Name="Tools menu">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="AskButton" Text="Summarize this page" Click="OnAsk"/>
                            <MenuFlyoutItem x:Name="MemoryButton" Text="Search pages you have read" Click="OnMemory"/>
                            <MenuFlyoutItem x:Name="BrainButton" Text="AI settings and log" Click="OnBrain"/>
                            <MenuFlyoutItem x:Name="DevButton" Text="Developer tools" Click="OnDev"/>
                            <MenuFlyoutItem x:Name="AgentsButton" Text="Agents" Click="OnAgents"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Border Grid.Row="1" CornerRadius="16" BorderBrush="{StaticResource JevLineBrush}" BorderThickness="1" Background="#000000" Shadow="{StaticResource JevShadow}" Translation="0,0,16">
                <Grid>
                    <Grid x:Name="WebHost" CornerRadius="16">
                        <!-- Shown while a sleeping tab comes back, and when nothing is selected. Never implies the
                             live page is present: the preview is labelled as a saved image. -->
                        <StackPanel x:Name="RestorePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460" Padding="24">
                            <Border x:Name="PreviewFrame" Visibility="Collapsed" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource JevLineBrush}" HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="PreviewImage" MaxHeight="240" Stretch="Uniform"/>
                                    <Border Background="#B0000000" VerticalAlignment="Bottom" Padding="8,4">
                                        <TextBlock Text="Previous view — a saved image, not the live page" FontSize="11" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="RestoreTitle" HorizontalAlignment="Center" TextAlignment="Center" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RestoreStatus" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12.5" Opacity="0.7" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="RestoreProgress" IsIndeterminate="True" Width="200" Visibility="Collapsed"/>
                            <StackPanel x:Name="RestoreActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Try again" Click="OnRestoreRetry" Style="{StaticResource JevToolButton}"/>
                                <Button Content="Open the address" Click="OnRestoreOpenAddress" Style="{StaticResource JevToolButton}"/>
                                <Button Content="Keep this tab active" Click="OnRestoreKeepActive" Style="{StaticResource JevToolButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ProdBorder" CornerRadius="16" BorderBrush="#E0FF3B30" BorderThickness="4" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Border x:Name="EnvBadge" Background="#E0FF3B30" CornerRadius="0,0,10,0" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="EnvBadgeText" Foreground="White" FontWeight="Bold" FontSize="12" Text="PROD"/>
                    </Border>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusText" Grid.Row="2" Padding="8,6,8,0" FontSize="12" TextWrapping="Wrap" Opacity="0.85" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</Window>

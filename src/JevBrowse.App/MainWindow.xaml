<Window x:Class="JevBrowse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JevBrowse">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Click="OnBack"/>
            <Button x:Name="ForwardButton" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Grid.Column="1" Click="OnForward"/>
            <TextBox x:Name="AddressBox" Grid.Column="2" PlaceholderText="Search or enter address" KeyDown="OnAddressKeyDown"/>
            <Button x:Name="LabButton" Grid.Column="3" Content="Memory Lab" Click="OnMemoryLab"/>
            <Button x:Name="DisposeButton" Grid.Column="4" Content="Dispose renderer" Click="OnDispose"/>
        </Grid>

        <Grid x:Name="WebHost" Grid.Row="1"/>

        <TextBlock x:Name="StatusText" Grid.Row="2" Padding="8,4" FontFamily="Consolas" TextWrapping="Wrap"/>
    </Grid>
</Window>

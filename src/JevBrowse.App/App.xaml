<Application x:Class="JevBrowse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- JevBrowse palette: deep navy surfaces, teal→violet accent, glowing state dots. -->
            <Color x:Key="JevBg">#0B0D12</Color>
            <Color x:Key="JevPanel">#121620</Color>
            <Color x:Key="JevLine">#1E2533</Color>
            <Color x:Key="JevTeal">#20D6C6</Color>
            <Color x:Key="JevViolet">#8B7BFF</Color>
            <SolidColorBrush x:Key="JevBgBrush" Color="{StaticResource JevBg}"/>
            <SolidColorBrush x:Key="JevPanelBrush" Color="{StaticResource JevPanel}"/>
            <SolidColorBrush x:Key="JevLineBrush" Color="{StaticResource JevLine}"/>
            <SolidColorBrush x:Key="JevTealBrush" Color="{StaticResource JevTeal}"/>
            <LinearGradientBrush x:Key="JevAccentBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource JevTeal}" Offset="0"/>
                <GradientStop Color="{StaticResource JevViolet}" Offset="1"/>
            </LinearGradientBrush>
            <ThemeShadow x:Key="JevShadow"/>
            <Style x:Key="JevToolButton" TargetType="Button">
                <Setter Property="Background" Value="#161B27"/>
                <Setter Property="BorderBrush" Value="{StaticResource JevLineBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
            <Style x:Key="JevCombo" TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="#161B27"/>
                <Setter Property="BorderBrush" Value="{StaticResource JevLineBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

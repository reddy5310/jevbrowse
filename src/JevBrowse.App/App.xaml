<Application x:Class="JevBrowse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              SEMANTIC TOKENS. Nothing in the interface names a raw colour; it names what the colour is FOR.

              Depth:     Surface0 (window) < Surface1 (panels) < Surface2 (raised controls) < Surface3 (hover/overlay).
              Light:     the active surface is marked by Accent, not by decoration everywhere.
              Text:      TextPrimary and TextSecondary are the only two text colours in the chrome. Dimming text with
                         Opacity is not allowed: it produces a contrast nobody chose. Both are tested against every
                         surface in tests/Unit/JevBrowse.Kernel.Tests/DesignTokenTests.cs (WCAG 2.x, parsed from THIS file).
              Themes:    Dark (the default), Light, and HighContrast. HighContrast uses ONLY Windows system colours, so the
                         user's contrast theme is what they see; a test enforces that.
              Colour is never the only carrier: tab state and data class are also words (see TabItem, ClassLabel).
            -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="JevSurface0">#0B0D12</Color>
                    <Color x:Key="JevSurface1">#121620</Color>
                    <Color x:Key="JevSurface2">#1A2030</Color>
                    <Color x:Key="JevSurface3">#252D42</Color>
                    <Color x:Key="JevBorderSubtle">#1E2533</Color>
                    <Color x:Key="JevBorderStrong">#66718C</Color>
                    <Color x:Key="JevTextPrimary">#EAEEF6</Color>
                    <Color x:Key="JevTextSecondary">#A9B1C3</Color>
                    <Color x:Key="JevFocus">#7FE8DF</Color>
                    <Color x:Key="JevAccent">#20D6C6</Color>
                    <Color x:Key="JevAccentOn">#04201D</Color>
                    <Color x:Key="JevViolet">#9A8CFF</Color>
                    <Color x:Key="JevBackdrop">#05070B</Color>
                    <Color x:Key="JevStateHot">#3DDC84</Color>
                    <Color x:Key="JevStateWarm">#FFB454</Color>
                    <Color x:Key="JevStateCold">#4AA3FF</Color>
                    <Color x:Key="JevStateSuspended">#9A8CFF</Color>
                    <Color x:Key="JevStateVirtual">#7A8399</Color>
                    <Color x:Key="JevStateArchived">#66718C</Color>
                    <Color x:Key="JevBadgePublic">#1F6B4A</Color>
                    <Color x:Key="JevBadgeUnknown">#4A5468</Color>
                    <Color x:Key="JevBadgeSignedIn">#2A64A8</Color>
                    <Color x:Key="JevBadgeSensitive">#A64B08</Color>
                    <Color x:Key="JevBadgeSecret">#B3261E</Color>
                    <Color x:Key="JevBadgePrivate">#5B3FA0</Color>
                    <Color x:Key="JevBadgeText">#FFFFFF</Color>
                    <Color x:Key="JevDanger">#C62828</Color>
                    <Color x:Key="JevDangerText">#FFFFFF</Color>
                    <Color x:Key="JevEnvStaging">#9A5200</Color>
                    <Color x:Key="JevEnvDev">#1F5FB8</Color>
                    <Color x:Key="JevEnvOther">#1E7A46</Color>
                    <Color x:Key="JevScrim">#B0000000</Color>
                    <SolidColorBrush x:Key="JevSurface0Brush" Color="{StaticResource JevSurface0}"/>
                    <SolidColorBrush x:Key="JevSurface1Brush" Color="{StaticResource JevSurface1}"/>
                    <SolidColorBrush x:Key="JevSurface2Brush" Color="{StaticResource JevSurface2}"/>
                    <SolidColorBrush x:Key="JevSurface3Brush" Color="{StaticResource JevSurface3}"/>
                    <SolidColorBrush x:Key="JevBorderSubtleBrush" Color="{StaticResource JevBorderSubtle}"/>
                    <SolidColorBrush x:Key="JevBorderStrongBrush" Color="{StaticResource JevBorderStrong}"/>
                    <SolidColorBrush x:Key="JevTextPrimaryBrush" Color="{StaticResource JevTextPrimary}"/>
                    <SolidColorBrush x:Key="JevTextSecondaryBrush" Color="{StaticResource JevTextSecondary}"/>
                    <SolidColorBrush x:Key="JevFocusBrush" Color="{StaticResource JevFocus}"/>
                    <SolidColorBrush x:Key="JevAccentSolidBrush" Color="{StaticResource JevAccent}"/>
                    <SolidColorBrush x:Key="JevAccentOnBrush" Color="{StaticResource JevAccentOn}"/>
                    <SolidColorBrush x:Key="JevBackdropBrush" Color="{StaticResource JevBackdrop}"/>
                    <SolidColorBrush x:Key="JevStateHotBrush" Color="{StaticResource JevStateHot}"/>
                    <SolidColorBrush x:Key="JevStateWarmBrush" Color="{StaticResource JevStateWarm}"/>
                    <SolidColorBrush x:Key="JevStateColdBrush" Color="{StaticResource JevStateCold}"/>
                    <SolidColorBrush x:Key="JevStateSuspendedBrush" Color="{StaticResource JevStateSuspended}"/>
                    <SolidColorBrush x:Key="JevStateVirtualBrush" Color="{StaticResource JevStateVirtual}"/>
                    <SolidColorBrush x:Key="JevStateArchivedBrush" Color="{StaticResource JevStateArchived}"/>
                    <SolidColorBrush x:Key="JevBadgePublicBrush" Color="{StaticResource JevBadgePublic}"/>
                    <SolidColorBrush x:Key="JevBadgeUnknownBrush" Color="{StaticResource JevBadgeUnknown}"/>
                    <SolidColorBrush x:Key="JevBadgeSignedInBrush" Color="{StaticResource JevBadgeSignedIn}"/>
                    <SolidColorBrush x:Key="JevBadgeSensitiveBrush" Color="{StaticResource JevBadgeSensitive}"/>
                    <SolidColorBrush x:Key="JevBadgeSecretBrush" Color="{StaticResource JevBadgeSecret}"/>
                    <SolidColorBrush x:Key="JevBadgePrivateBrush" Color="{StaticResource JevBadgePrivate}"/>
                    <SolidColorBrush x:Key="JevBadgeTextBrush" Color="{StaticResource JevBadgeText}"/>
                    <SolidColorBrush x:Key="JevDangerBrush" Color="{StaticResource JevDanger}"/>
                    <SolidColorBrush x:Key="JevDangerTextBrush" Color="{StaticResource JevDangerText}"/>
                    <SolidColorBrush x:Key="JevEnvStagingBrush" Color="{StaticResource JevEnvStaging}"/>
                    <SolidColorBrush x:Key="JevEnvDevBrush" Color="{StaticResource JevEnvDev}"/>
                    <SolidColorBrush x:Key="JevEnvOtherBrush" Color="{StaticResource JevEnvOther}"/>
                    <SolidColorBrush x:Key="JevScrimBrush" Color="{StaticResource JevScrim}"/>
                    <LinearGradientBrush x:Key="JevAccentBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource JevAccent}" Offset="0"/>
                        <GradientStop Color="{StaticResource JevViolet}" Offset="1"/>
                    </LinearGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="JevSurface0">#F3F5F9</Color>
                    <Color x:Key="JevSurface1">#FFFFFF</Color>
                    <Color x:Key="JevSurface2">#EDF0F6</Color>
                    <Color x:Key="JevSurface3">#E1E6EF</Color>
                    <Color x:Key="JevBorderSubtle">#D5DBE6</Color>
                    <Color x:Key="JevBorderStrong">#6B7488</Color>
                    <Color x:Key="JevTextPrimary">#121622</Color>
                    <Color x:Key="JevTextSecondary">#485065</Color>
                    <Color x:Key="JevFocus">#0B6B63</Color>
                    <Color x:Key="JevAccent">#0B8177</Color>
                    <Color x:Key="JevAccentOn">#FFFFFF</Color>
                    <Color x:Key="JevViolet">#5B4FD6</Color>
                    <Color x:Key="JevBackdrop">#FFFFFF</Color>
                    <Color x:Key="JevStateHot">#1E8E4E</Color>
                    <Color x:Key="JevStateWarm">#B26A00</Color>
                    <Color x:Key="JevStateCold">#1F6FB8</Color>
                    <Color x:Key="JevStateSuspended">#5B4FD6</Color>
                    <Color x:Key="JevStateVirtual">#6B7488</Color>
                    <Color x:Key="JevStateArchived">#6B7488</Color>
                    <Color x:Key="JevBadgePublic">#1F6B4A</Color>
                    <Color x:Key="JevBadgeUnknown">#4A5468</Color>
                    <Color x:Key="JevBadgeSignedIn">#2A64A8</Color>
                    <Color x:Key="JevBadgeSensitive">#A64B08</Color>
                    <Color x:Key="JevBadgeSecret">#B3261E</Color>
                    <Color x:Key="JevBadgePrivate">#5B3FA0</Color>
                    <Color x:Key="JevBadgeText">#FFFFFF</Color>
                    <Color x:Key="JevDanger">#C62828</Color>
                    <Color x:Key="JevDangerText">#FFFFFF</Color>
                    <Color x:Key="JevEnvStaging">#9A5200</Color>
                    <Color x:Key="JevEnvDev">#1F5FB8</Color>
                    <Color x:Key="JevEnvOther">#1E7A46</Color>
                    <Color x:Key="JevScrim">#B0000000</Color>
                    <SolidColorBrush x:Key="JevSurface0Brush" Color="{StaticResource JevSurface0}"/>
                    <SolidColorBrush x:Key="JevSurface1Brush" Color="{StaticResource JevSurface1}"/>
                    <SolidColorBrush x:Key="JevSurface2Brush" Color="{StaticResource JevSurface2}"/>
                    <SolidColorBrush x:Key="JevSurface3Brush" Color="{StaticResource JevSurface3}"/>
                    <SolidColorBrush x:Key="JevBorderSubtleBrush" Color="{StaticResource JevBorderSubtle}"/>
                    <SolidColorBrush x:Key="JevBorderStrongBrush" Color="{StaticResource JevBorderStrong}"/>
                    <SolidColorBrush x:Key="JevTextPrimaryBrush" Color="{StaticResource JevTextPrimary}"/>
                    <SolidColorBrush x:Key="JevTextSecondaryBrush" Color="{StaticResource JevTextSecondary}"/>
                    <SolidColorBrush x:Key="JevFocusBrush" Color="{StaticResource JevFocus}"/>
                    <SolidColorBrush x:Key="JevAccentSolidBrush" Color="{StaticResource JevAccent}"/>
                    <SolidColorBrush x:Key="JevAccentOnBrush" Color="{StaticResource JevAccentOn}"/>
                    <SolidColorBrush x:Key="JevBackdropBrush" Color="{StaticResource JevBackdrop}"/>
                    <SolidColorBrush x:Key="JevStateHotBrush" Color="{StaticResource JevStateHot}"/>
                    <SolidColorBrush x:Key="JevStateWarmBrush" Color="{StaticResource JevStateWarm}"/>
                    <SolidColorBrush x:Key="JevStateColdBrush" Color="{StaticResource JevStateCold}"/>
                    <SolidColorBrush x:Key="JevStateSuspendedBrush" Color="{StaticResource JevStateSuspended}"/>
                    <SolidColorBrush x:Key="JevStateVirtualBrush" Color="{StaticResource JevStateVirtual}"/>
                    <SolidColorBrush x:Key="JevStateArchivedBrush" Color="{StaticResource JevStateArchived}"/>
                    <SolidColorBrush x:Key="JevBadgePublicBrush" Color="{StaticResource JevBadgePublic}"/>
                    <SolidColorBrush x:Key="JevBadgeUnknownBrush" Color="{StaticResource JevBadgeUnknown}"/>
                    <SolidColorBrush x:Key="JevBadgeSignedInBrush" Color="{StaticResource JevBadgeSignedIn}"/>
                    <SolidColorBrush x:Key="JevBadgeSensitiveBrush" Color="{StaticResource JevBadgeSensitive}"/>
                    <SolidColorBrush x:Key="JevBadgeSecretBrush" Color="{StaticResource JevBadgeSecret}"/>
                    <SolidColorBrush x:Key="JevBadgePrivateBrush" Color="{StaticResource JevBadgePrivate}"/>
                    <SolidColorBrush x:Key="JevBadgeTextBrush" Color="{StaticResource JevBadgeText}"/>
                    <SolidColorBrush x:Key="JevDangerBrush" Color="{StaticResource JevDanger}"/>
                    <SolidColorBrush x:Key="JevDangerTextBrush" Color="{StaticResource JevDangerText}"/>
                    <SolidColorBrush x:Key="JevEnvStagingBrush" Color="{StaticResource JevEnvStaging}"/>
                    <SolidColorBrush x:Key="JevEnvDevBrush" Color="{StaticResource JevEnvDev}"/>
                    <SolidColorBrush x:Key="JevEnvOtherBrush" Color="{StaticResource JevEnvOther}"/>
                    <SolidColorBrush x:Key="JevScrimBrush" Color="{StaticResource JevScrim}"/>
                    <LinearGradientBrush x:Key="JevAccentBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource JevAccent}" Offset="0"/>
                        <GradientStop Color="{StaticResource JevViolet}" Offset="1"/>
                    </LinearGradientBrush>
                </ResourceDictionary>

                <!-- Windows contrast themes: ONLY system colours, so the user's own choice is what appears. State and data
                     class are also spoken as words everywhere, so nothing depends on hue here. -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="JevSurface0Brush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="JevSurface1Brush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="JevSurface2Brush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="JevSurface3Brush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="JevBorderSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="JevBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="JevTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="JevTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="JevFocusBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="JevAccentSolidBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="JevAccentOnBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="JevBackdropBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="JevStateHotBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="JevStateWarmBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="JevStateColdBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="JevStateSuspendedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="JevStateVirtualBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="JevStateArchivedBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="JevBadgePublicBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="JevBadgeUnknownBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="JevBadgeSignedInBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="JevBadgeSensitiveBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="JevBadgeSecretBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="JevBadgePrivateBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="JevBadgeTextBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
                    <SolidColorBrush x:Key="JevDangerBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="JevDangerTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="JevEnvStagingBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="JevEnvDevBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="JevEnvOtherBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="JevScrimBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="JevAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <ThemeShadow x:Key="JevShadow"/>

            <!--
              LAYOUT TOKENS: the same rule as colour. The window names a ROLE ("panel radius", "sidebar inset"), never a number,
              so the scale can be changed in one place and a test can hold it to a rule (DesignTokenTests).

              Radius:     Dot < Sm < Control < Card < Pill < Panel. (Five near-identical radii were in use; they are now a scale.)
              Space:      the gaps between things. On a 2 px grid; nothing between the steps.
              Inset:      padding and margin as named roles, so "how far the sidebar sits from the edge" has one answer.
              Elevation:  how far a surface sits above the one beneath it: four Z depths, applied with local:Elevation.Level.
            -->
            <CornerRadius x:Key="JevRadiusDot">5</CornerRadius>
            <CornerRadius x:Key="JevRadiusSm">8</CornerRadius>
            <CornerRadius x:Key="JevRadiusControl">10</CornerRadius>
            <CornerRadius x:Key="JevRadiusCard">12</CornerRadius>
            <CornerRadius x:Key="JevRadiusPill">14</CornerRadius>
            <CornerRadius x:Key="JevRadiusPanel">16</CornerRadius>
            <CornerRadius x:Key="JevRadiusTag">0,0,10,0</CornerRadius>

            <x:Double x:Key="JevSpace2">2</x:Double>
            <x:Double x:Key="JevSpace4">4</x:Double>
            <x:Double x:Key="JevSpace6">6</x:Double>
            <x:Double x:Key="JevSpace8">8</x:Double>
            <x:Double x:Key="JevSpace10">10</x:Double>
            <x:Double x:Key="JevSpace12">12</x:Double>

            <Thickness x:Key="JevInsetTitle">14,0</Thickness>
            <Thickness x:Key="JevInsetSidebar">10,8,4,10</Thickness>
            <Thickness x:Key="JevInsetSidebarHead">12,12,12,6</Thickness>
            <Thickness x:Key="JevInsetSidebarFoot">10,6,10,10</Thickness>
            <Thickness x:Key="JevInsetMain">4,8,10,10</Thickness>
            <Thickness x:Key="JevInsetMainFull">10,8,10,10</Thickness>
            <Thickness x:Key="JevInsetToolbar">0,0,0,8</Thickness>
            <Thickness x:Key="JevInsetStatus">8,6,8,0</Thickness>
            <Thickness x:Key="JevInsetSlim">6,0</Thickness>
            <Thickness x:Key="JevInsetTight">4</Thickness>
            <Thickness x:Key="JevInsetBox">10,8</Thickness>
            <Thickness x:Key="JevInsetControl">10,6</Thickness>
            <Thickness x:Key="JevInsetBadge">8,2</Thickness>
            <Thickness x:Key="JevInsetTag">10,3</Thickness>
            <Thickness x:Key="JevInsetScrim">8,4</Thickness>
            <Thickness x:Key="JevInsetPanelPad">24</Thickness>
            <Thickness x:Key="JevInsetNote">0,6,0,0</Thickness>

            <!-- Depth in device-independent pixels of Z above the surface beneath. Applied with local:Elevation.Level="Panel". -->
            <x:Double x:Key="JevElevationGlow">8</x:Double>
            <x:Double x:Key="JevElevationRaised">12</x:Double>
            <x:Double x:Key="JevElevationSurface">16</x:Double>
            <x:Double x:Key="JevElevationPanel">24</x:Double>

            <!-- Text that names no colour is the primary text token. (A Grid has no Foreground to inherit from, so the
                 default is set here, once, and every TextBlock in the window and in dialogs picks it up.) -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource JevTextPrimaryBrush}"/>
            </Style>

            <Style x:Key="JevToolButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource JevSurface2Brush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource JevBorderSubtleBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource JevRadiusControl}"/>
                <Setter Property="Padding" Value="{StaticResource JevInsetControl}"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
            <Style x:Key="JevCombo" TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="{StaticResource JevRadiusControl}"/>
                <Setter Property="Background" Value="{ThemeResource JevSurface2Brush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource JevBorderSubtleBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>JevBrowse.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged dev build: no VS/MSIX tooling needed. MSIX is a Phase 11 concern. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JevBrowse.Domain\JevBrowse.Domain.csproj" />
    <ProjectReference Include="..\JevBrowse.Diagnostics\JevBrowse.Diagnostics.csproj" />
    <ProjectReference Include="..\JevBrowse.VirtualTabs\JevBrowse.VirtualTabs.csproj" />
    <ProjectReference Include="..\JevBrowse.Storage\JevBrowse.Storage.csproj" />
    <ProjectReference Include="..\JevBrowse.Renderer.Abstractions\JevBrowse.Renderer.Abstractions.csproj" />
    <ProjectReference Include="..\JevBrowse.Shield\JevBrowse.Shield.csproj" />
    <ProjectReference Include="..\JevBrowse.TrustOS\JevBrowse.TrustOS.csproj" />
    <ProjectReference Include="..\JevBrowse.Brain\JevBrowse.Brain.csproj" />
    <ProjectReference Include="..\JevBrowse.Memory\JevBrowse.Memory.csproj" />
    <ProjectReference Include="..\JevBrowse.DevSpace\JevBrowse.DevSpace.csproj" />
  </ItemGroup>
</Project>

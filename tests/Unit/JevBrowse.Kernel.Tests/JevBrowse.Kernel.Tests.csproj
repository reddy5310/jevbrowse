<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Databases written by the REAL historic builds (scripts/make-db-fixtures.ps1), one per schema version. -->
    <Content Include="..\..\Fixtures\db\*.db" Link="Fixtures\db\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\JevBrowse.VirtualTabs\JevBrowse.VirtualTabs.csproj" />
    <ProjectReference Include="..\..\..\src\JevBrowse.Storage\JevBrowse.Storage.csproj" />
    <ProjectReference Include="..\..\..\src\JevBrowse.Renderer.Abstractions\JevBrowse.Renderer.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\JevBrowse.Domain\JevBrowse.Domain.csproj" />
    <!-- The child process the crash tests start and kill. -->
    <ProjectReference Include="..\..\Tools\CrashHarness\CrashHarness.csproj" />
  </ItemGroup>

</Project>